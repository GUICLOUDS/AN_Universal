    title = tostring(title or "")
    kind = kind or "movie"
    for i, entry in ipairs(Favorites) do
        if type(entry) == "table" and tostring(entry.Title or "") == title and (entry.Kind or "movie") == kind then
            return i
        end
    end
    return nil
end

